# Copy this file to .env and fill in your own values.
PORT=3000
NODE_ENV=development

# MongoDB Atlas > your cluster > Connect > Drivers
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/kisandirect?retryWrites=true&w=majority

# Use a long random value (at least 32 characters). Do not commit .env.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Optional: configure Cloudinary for farmer listing photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: data.gov.in market price API. If absent, the endpoint reports not configured.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
